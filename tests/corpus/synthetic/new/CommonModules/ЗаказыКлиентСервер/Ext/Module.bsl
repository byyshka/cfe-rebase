#Область ПрограммныйИнтерфейс

// Возвращает представление суммы заказа с валютой.
//
// Параметры:
//  Сумма - Число - сумма заказа.
//  Валюта - СправочникСсылка, Строка - валюта суммы.
//
// Возвращаемое значение:
//  Строка - представление суммы.
//
Функция ПредставлениеСуммыЗаказа(Сумма, Валюта) Экспорт
	
	Текст = Формат(Сумма, "ЧДЦ=2; ЧН=0");
#Если Сервер Тогда
	Текст = Текст + " " + Строка(Валюта);
#Иначе
	Текст = Текст + " " + Валюта;
#КонецЕсли
	Возврат Текст;
	
КонецФункции

#КонецОбласти
