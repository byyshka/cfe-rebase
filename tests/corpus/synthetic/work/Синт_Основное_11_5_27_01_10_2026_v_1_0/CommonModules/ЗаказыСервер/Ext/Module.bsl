&ИзменениеИКонтроль("ЗаполнитьРеквизитыЗаказа")
Процедура Синт_ЗаполнитьРеквизитыЗаказа(Заказ) Экспорт
	
	Если Не ЗначениеЗаполнено(Заказ.Дата) Тогда
		Заказ.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Заказ.Склад) Тогда
		Заказ.Склад = СкладПоУмолчанию();
	КонецЕсли;
	#Вставка
	Если Не ЗначениеЗаполнено(Заказ.Комментарий) Тогда
		Заказ.Комментарий = "Заполнено расширением Синт";
	КонецЕсли;
	#КонецВставки
	
КонецПроцедуры

&ИзменениеИКонтроль("РассчитатьСуммуЗаказа")
Процедура Синт_РассчитатьСуммуЗаказа(Заказ) Экспорт
	Итого = 0;
	#Вставка
	Синт_ПроверитьЦены(Заказ);
	#КонецВставки
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		ПозицияЗаказа.Сумма = ПозицияЗаказа.Количество * ПозицияЗаказа.Цена;
		Итого = Итого + ПозицияЗаказа.Сумма;
	КонецЦикла;
	Заказ.СуммаДокумента = Окр(Итого, 2);
	
КонецПроцедуры

&ИзменениеИКонтроль("ПроверитьЗаполнениеЗаказа")
Процедура Синт_ПроверитьЗаполнениеЗаказа(Заказ, Отказ) Экспорт
	
	Если Заказ.Товары.Количество() = 0 Тогда
		Отказ = Истина;
	КонецЕсли;
	#Вставка // Автор 01.10 склад обязателен для отгрузки
	Отказ = Отказ Или Не ЗначениеЗаполнено(Заказ.Склад);
	#КонецВставки // Автор 01.10
	Если Не ЗначениеЗаполнено(Заказ.Контрагент) Тогда
		Отказ = Истина;
	КонецЕсли;
	Если Заказ.СуммаДокумента < 0 Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&ИзменениеИКонтроль("ОпределитьСклад")
Функция Синт_ОпределитьСклад(Заказ) Экспорт
	
	#Удаление
	Склад = Заказ.СкладОтгрузки;
	#КонецУдаления
	#Вставка
	Склад = Синт_СкладИзНастроек(Заказ);
	#КонецВставки
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = СкладПоУмолчанию();
	КонецЕсли;
	Возврат Склад;
	
КонецФункции

&ИзменениеИКонтроль("ЗаписатьПротоколЗаказа")
Процедура Синт_ЗаписатьПротоколЗаказа(Заказ,
		ВидСобытия,
		Комментарий, Пользователь = Неопределено) Экспорт
	
	Запись = Новый Структура;
	Запись.Вставить("Заказ", Заказ);
	#Вставка
	Запись.Вставить("Источник", "Синт");
	#КонецВставки
	Запись.Вставить("ВидСобытия", ВидСобытия);
	Запись.Вставить("Комментарий", Комментарий);
	Запись.Вставить("Пользователь", Пользователь);
	ЗаписатьСобытие(Запись);
	
КонецПроцедуры

&ИзменениеИКонтроль("ОбработатьСтрокиЗаказа")
Процедура Синт_ОбработатьСтрокиЗаказа(Заказ) Экспорт
	
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		#Вставка
		Если Не ЗначениеЗаполнено(ПозицияЗаказа.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		#КонецВставки
		Если ПозицияЗаказа.Количество <= 0 Тогда
			ПозицияЗаказа.Количество = 1;
		КонецЕсли;
		Если ПозицияЗаказа.Цена < 0 Тогда
			ПозицияЗаказа.Цена = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&Вместо("ПодготовитьДанныеПечати")
Функция Синт_ПодготовитьДанныеПечати(Заказ, ПараметрыПечати)
	
	Данные = ПродолжитьВызов(Заказ, ПараметрыПечати);
	Данные.Вставить("Комментарий", Заказ.Комментарий);
	Возврат Данные;
	
КонецФункции

&Вместо("СформироватьПредставлениеЗаказа")
Функция Синт_СформироватьПредставлениеЗаказа(Заказ)
	
	Представление = "Заказ " + Заказ.Номер + " от " + Формат(Заказ.Дата, "ДЛФ=D");
	Если ЗначениеЗаполнено(Заказ.Контрагент) Тогда
		Представление = Представление + ", " + Строка(Заказ.Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Заказ.Склад) Тогда
		Представление = Представление + ", склад " + Строка(Заказ.Склад);
	КонецЕсли;
	Возврат Представление;
	
КонецФункции

&После("ЗарегистрироватьИзменениеЗаказа")
Процедура Синт_ЗарегистрироватьИзменениеЗаказаПосле(Заказ, Источник)
	
	Заказ.ДополнительныеСвойства.Вставить("Синт_Изменен", Истина);
	
КонецПроцедуры

&Перед("ОбновитьСтатусЗаказа")
Процедура Синт_ОбновитьСтатусЗаказаПеред(Заказ, НовыйСтатус)
	
	НовыйСтатус = Неопределено;
	
КонецПроцедуры

&ИзменениеИКонтроль("КоличествоПозицийЗаказа")
Функция Синт_КоличествоПозицийЗаказа(Заказ) Экспорт
	
	Количество = 0;
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		Если ПозицияЗаказа.Количество <> 0 Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	#Вставка
	Количество = Макс(Количество, 1);
	#КонецВставки
	Возврат Количество;
	
КонецФункции // КоличествоПозицийЗаказа()

&ИзменениеИКонтроль("РассчитатьВесЗаказа")
Функция Синт_РассчитатьВесЗаказа(Заказ) Экспорт
	
	Вес = 0;
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		#Удаление
		Вес = Вес + ПозицияЗаказа.Количество;
		#КонецУдаления
		#Вставка
		Вес = Вес + ПозицияЗаказа.Количество * ПозицияЗаказа.Коэффициент;
		#КонецВставки
	КонецЦикла;
	Возврат Окр(Вес, 3);
	
КонецФункции

Процедура Синт_ПроверитьЦены(Заказ)
	
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		ПозицияЗаказа.Цена = Макс(ПозицияЗаказа.Цена, 0);
	КонецЦикла;
	
КонецПроцедуры

Функция Синт_СкладИзНастроек(Заказ)
	
	Возврат Справочники.Склады.НайтиПоНаименованию("Синт: основной склад");
	
КонецФункции
