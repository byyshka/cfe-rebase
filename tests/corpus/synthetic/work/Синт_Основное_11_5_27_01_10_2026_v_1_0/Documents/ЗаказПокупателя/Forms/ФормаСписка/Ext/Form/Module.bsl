&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура Синт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	#Вставка
	Список.Параметры.УстановитьЗначениеПараметра("Синт_ТолькоСвоиЗаказы", Истина);
	#КонецВставки
	Список.Параметры.УстановитьЗначениеПараметра("ДатаОтбораЗаказов", НачалоДня(ТекущаяДатаСеанса()));
	Элементы.Список.Подсказка = НСтр("ru = 'Заказы начиная с текущего дня'");
	
КонецПроцедуры
