#Область ПрограммныйИнтерфейс

// Заполняет пустые реквизиты шапки заказа значениями по умолчанию.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заполняемый заказ.
//
Процедура ЗаполнитьРеквизитыЗаказа(Заказ) Экспорт
	
	Если Не ЗначениеЗаполнено(Заказ.Дата) Тогда
		Заказ.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Заказ.Склад) Тогда
		Заказ.Склад = СкладПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

// Пересчитывает суммы позиций и итог заказа.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
Процедура РассчитатьСуммуЗаказа(Заказ) Экспорт
	
	Итого = 0;
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		ПозицияЗаказа.Сумма = ПозицияЗаказа.Количество * ПозицияЗаказа.Цена;
		Итого = Итого + ПозицияЗаказа.Сумма;
	КонецЦикла;
	Заказ.СуммаДокумента = Итого;
	
КонецПроцедуры

// Проверяет заполнение заказа перед записью.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - проверяемый заказ.
//  Отказ - Булево - устанавливается в Истина, если заказ заполнен неверно.
//
Процедура ПроверитьЗаполнениеЗаказа(Заказ, Отказ) Экспорт
	
	Если Заказ.Товары.Количество() = 0 Тогда
		Отказ = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Заказ.Контрагент) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает склад отгрузки заказа.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  СправочникСсылка.Склады - склад.
//
Функция ОпределитьСклад(Заказ) Экспорт
	
	Склад = Заказ.Склад;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = СкладПоУмолчанию();
	КонецЕсли;
	Возврат Склад;
	
КонецФункции

// Записывает событие заказа в протокол.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//  ВидСобытия - Строка - вид события.
//  Комментарий - Строка - пояснение.
//
Процедура ЗаписатьПротоколЗаказа(Заказ,
		ВидСобытия,
		Комментарий) Экспорт
	
	Запись = Новый Структура;
	Запись.Вставить("Заказ", Заказ);
	Запись.Вставить("ВидСобытия", ВидСобытия);
	Запись.Вставить("Комментарий", Комментарий);
	ЗаписатьСобытие(Запись);
	
КонецПроцедуры

// Обрабатывает позиции заказа перед расчетом.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
Процедура ОбработатьСтрокиЗаказа(Заказ) Экспорт
	
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		Если ПозицияЗаказа.Количество <= 0 Тогда
			ПозицияЗаказа.Количество = 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Готовит данные для печати заказа.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//  ПараметрыПечати - Структура - параметры печатной формы.
//
// Возвращаемое значение:
//  Структура - данные печати.
//
Функция ПодготовитьДанныеПечати(Заказ, ПараметрыПечати) Экспорт
	
	Данные = Новый Структура;
	Данные.Вставить("Номер", Заказ.Номер);
	Данные.Вставить("Дата", Заказ.Дата);
	Данные.Вставить("Контрагент", Заказ.Контрагент);
	Данные.Вставить("Сумма", Заказ.СуммаДокумента);
	Возврат Данные;
	
КонецФункции

// Возвращает представление заказа для списков и сообщений.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Строка - представление.
//
Функция СформироватьПредставлениеЗаказа(Заказ) Экспорт
	
	Шаблон = НСтр("ru = 'Заказ %1 от %2'");
	Представление = СтрШаблон(Шаблон, Заказ.Номер, Формат(Заказ.Дата, "ДЛФ=D"));
	Если ЗначениеЗаполнено(Заказ.Контрагент) Тогда
		Представление = Представление + ", " + Строка(Заказ.Контрагент);
	КонецЕсли;
	Возврат Представление;
	
КонецФункции

// Регистрирует изменение заказа.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
Процедура ЗарегистрироватьИзменениеЗаказа(Заказ) Экспорт
	
	ЗаписатьПротоколЗаказа(Заказ, "Изменение", "");
	
КонецПроцедуры

// Устанавливает статус заказа по его сумме.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
Процедура ОбновитьСтатусЗаказа(Заказ) Экспорт
	
	Если Заказ.СуммаДокумента = 0 Тогда
		Заказ.Статус = Перечисления.СтатусыЗаказов.Черновик;
	Иначе
		Заказ.Статус = Перечисления.СтатусыЗаказов.КОтгрузке;
	КонецЕсли;
	
КонецПроцедуры

// Пересчитывает скидки позиций заказа.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
Процедура ПересчитатьСкидки(Заказ) Экспорт
	
	Ставка = ПолучитьСтавкуСкидки(Заказ.Контрагент);
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		ПозицияЗаказа.СуммаСкидки = ПозицияЗаказа.Сумма * Ставка / 100;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает ставку скидки контрагента в процентах.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент.
//
// Возвращаемое значение:
//  Число - ставка.
//
Функция ПолучитьСтавкуСкидки(Контрагент) Экспорт
	
	Возврат 0;
	
КонецФункции

// Возвращает сумму заказа с учетом статуса.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Число - сумма.
//
Функция СуммаПоСтатусу(Заказ) Экспорт
	
	Возврат Заказ.СуммаДокумента;
	
КонецФункции

// Возвращает количество позиций заказа с ненулевым количеством.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Число - количество позиций.
//
Функция КоличествоПозицийЗаказа(Заказ) Экспорт
	
	Количество = 0;
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		Если ПозицияЗаказа.Количество > 0 Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции // КоличествоПозицийЗаказа()

// Возвращает суммарное количество единиц в заказе.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Число - количество единиц.
//
Функция РассчитатьВесЗаказа(Заказ) Экспорт
	
	Вес = 0;
	Для Каждого ПозицияЗаказа Из Заказ.Товары Цикл
		Вес = Вес + ПозицияЗаказа.Количество;
	КонецЦикла;
	Возврат Вес;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкладПоУмолчанию()
	
	Возврат Справочники.Склады.НайтиПоКоду("СКЛ-ДЕМО-01");
	
КонецФункции

Процедура ЗаписатьСобытие(Запись)
	
	Запись.Вставить("Записано", Истина);
	
КонецПроцедуры

#КонецОбласти
