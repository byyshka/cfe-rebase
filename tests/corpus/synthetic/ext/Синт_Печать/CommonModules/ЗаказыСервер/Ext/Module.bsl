&Вместо("ПодготовитьДанныеПечати")
Функция Синт_ПечатьПодготовитьДанныеПечати(Заказ, ПараметрыПечати)
	
	Данные = Новый Структура;
	Данные.Вставить("Номер", Заказ.Номер);
	Данные.Вставить("Дата", Заказ.Дата);
	Данные.Вставить("Контрагент", Заказ.Контрагент);
	Данные.Вставить("Сумма", Заказ.СуммаДокумента);
	Данные.Вставить("ПечататьПодпись", Истина);
	Возврат Данные;
	
КонецФункции
