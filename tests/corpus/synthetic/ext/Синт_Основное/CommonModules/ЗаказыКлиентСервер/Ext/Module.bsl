&ИзменениеИКонтроль("ПредставлениеСуммыЗаказа")
Функция Синт_ПредставлениеСуммыЗаказа(Сумма, Валюта) Экспорт
	
	Текст = Формат(Сумма, "ЧДЦ=2");
#Если Сервер Тогда
	Текст = Текст + " " + Строка(Валюта);
	#Вставка
	Текст = СокрЛП(Текст);
	#КонецВставки
#Иначе
	Текст = Текст + " " + Валюта;
#КонецЕсли
	Возврат Текст;
	
КонецФункции
