#Область ПрограммныйИнтерфейс

// Проверяет заказ перед отгрузкой.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Булево - заказ можно отгружать.
//
Функция Синт_ПроверитьЗаказ(Заказ) Экспорт
	
	Сумма = ЗаказыСервер.СуммаПоСтатусу(Заказ);
	Ставка = ЗаказыСервер.ПолучитьСтавкуСкидки(Заказ.Контрагент);
	Возврат Сумма > 0 И Ставка < 100;
	
КонецФункции

// Возвращает остаток и резерв номенклатуры на складе.
//
// Параметры:
//  Склад - СправочникСсылка.Склады - склад, по которому считается резерв.
//
// Возвращаемое значение:
//  ТаблицаЗначений - остатки.
//
Функция Синт_РезервПоСкладу(Склад) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезервыСклада.Номенклатура КАК Номенклатура,
	|	РезервыСклада.КоличествоОстаток КАК Количество,
	|	РезервыСклада.КоличествоВРезервеОстаток КАК Резерв
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &СкладРезерва) КАК РезервыСклада";
	Запрос.УстановитьПараметр("СкладРезерва", Склад);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

#КонецОбласти
